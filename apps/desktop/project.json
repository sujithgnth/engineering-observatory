{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/desktop/src",
  "tags": ["scope:desktop", "type:app", "runtime:electron"],
  "implicitDependencies": [
    "backend",
    "frontend",
    "performance-runner",
    "worker"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/desktop"],
      "options": {
        "command": "tsup apps/desktop/src/main.ts apps/desktop/src/preload.ts --format cjs --platform node --external electron --sourcemap --out-dir dist/apps/desktop --clean"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/desktop/tsconfig.json --noEmit"
      }
    }
  }
}
