{
  "name": "vscode-extension",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/vscode-extension/src",
  "tags": ["scope:developer-tools", "type:app", "runtime:vscode"],
  "implicitDependencies": ["shared-types"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsup apps/vscode-extension/src/extension.ts --format cjs --platform node --external vscode --sourcemap --out-dir apps/vscode-extension/dist --clean"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/vscode-extension/tsconfig.json --noEmit"
      }
    }
  }
}
