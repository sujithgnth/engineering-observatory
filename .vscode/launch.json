{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Frontend Intelligence Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode-extension/dist/**/*.cjs"],
      "preLaunchTask": "Build Frontend Intelligence Extension"
    }
  ]
}
